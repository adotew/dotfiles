// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "cursor_animation": {
    "enabled": true
  },
  "cli_default_open_behavior": "existing_window",
  "diff_view_style": "split",
  "edit_predictions": {
    "mode": "subtle",
    "provider": "zed"
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "model": "claude-sonnet-5"
      },
      "type": "registry"
    },
    "codex-acp": {
      "default_config_options": {
        "collaboration_mode": "plan",
        "reasoning_effort": "high",
        "model": "gpt-5.6-sol",
        "mode": "agent",
        "fast-mode": false
      },
      "type": "registry"
    },
    "opencode": {
      "default_config_options": {
        "mode": "build",
        "effort": "max",
        "model": "opencode-go/deepseek-v4-flash"
      },
      "type": "registry"
    },
    "pi-acp": {
      "type": "registry"
    }
  },
  "language_models": {
    "opencode": {
      "show_zen_models": false
    }
  },
  "git": {
    "path_style": "file_name_first",
    "blame": {
      "show_avatar": true
    },
    "gutter_debounce": 0,
    "git_gutter": "tracked_files",
    "enable_diff": true,
    "enable_status": true,
    "disable_git": false,
    "inline_blame": {
      "show_commit_summary": true
    }
  },
  "disable_ai": true,
  "relative_line_numbers": "enabled",
  "scrollbar": {
    "show": "never"
  },
  "zoomed_padding": true,
  "active_pane_modifiers": {
    "border_size": -3.0,
    "inactive_opacity": 1.0
  },
  "use_system_window_tabs": true,
  "focus_follows_mouse": {
    "enabled": false
  },
  "centered_layout": {
    "left_padding": null
  },
  "preview_tabs": {
    "enable_preview_from_project_panel": true,
    "enabled": true
  },
  "tabs": {
    "file_icons": false,
    "git_status": false
  },
  "tab_bar": {
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false,
    "show": true
  },
  "title_bar": {
    "button_layout": "platform_default",
    "show_menus": false,
    "show_onboarding_banner": true,
    "show_project_items": true,
    "show_branch_name": true,
    "show_branch_status_icon": false
  },
  "search": {
    "button": true
  },
  "diagnostics": {
    "button": true
  },
  "terminal": {
    "dock": "bottom",
    "font_weight": 250.0,
    "font_size": 10.5,
    "scroll_multiplier": 2.0,
    "button": false
  },
  "status_bar": {
    "active_encoding_button": "non_utf8",
    "cursor_position_button": true,
    "active_language_button": true
  },
  "proxy": "",
  "agent_ui_font_size": 12.0,
  "buffer_line_height": "comfortable",
  "ui_font_weight": 250.0,
  "ui_font_family": ".SystemUIFont",
  "buffer_font_weight": 200.0,
  "project_panel": {
    "folder_indicator": "chevron",
    "hide_hidden": false,
    "hide_root": true,
    "git_status_indicator": true,
    "scrollbar": {
      "horizontal_scroll": true
    },
    "bold_folder_labels": false,
    "git_status": true,
    "file_icons": true,
    "button": true,
    "dock": "left",
  },
  "outline_panel": {
    "folder_indicator": "icon",
    "dock": "left",
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left",
  },
  "agent": {
    "threads_sidebar": {
      "position": "right"
    },
    "inline_assistant_model": {
      "provider": "opencode",
      "model": "go/deepseek-v4-flash",
      "enable_thinking": false
    },
    "default_model": {
      "provider": "opencode",
      "model": "go/kimi-k2.6",
      "enable_thinking": false
    },
    "default_profile": "write",
    "profiles": {
      
    },
    "button": false,
    "dock": "right",
    "favorite_models": [
      {
        "provider": "opencode",
        "model": "go/kimi-k2.6",
        "enable_thinking": false
      },
      {
        "provider": "deepseek",
        "model": "deepseek-v4-pro",
        "enable_thinking": true,
        "effort": "high"
      }
    ],
    "model_parameters": [],
  },
  "git_panel": {
    "tree_view": true,
    "dock": "left",
  },
  "vim_mode": true,
  "base_keymap": "Cursor",
  "minimap": {
    "show": "never",
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "icon_theme": {
    "mode": "system",
    "light": "JetBrains New UI Icons (Light)",
    "dark": "JetBrains New UI Icons (Dark)",
  },
  "ui_font_size": 12.0,
  "buffer_font_size": 10.5,
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte - No Italics",
    "dark": "Catppuccin Mocha - No Italics",
  },
}
